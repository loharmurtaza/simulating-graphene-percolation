# -------------------------------------------------
# Graphene Percolation Simulation - environment config
# Copy this file to `.env` and adjust values as needed.
# All variables are required; relative paths are resolved
# against the directory you run the program from (the project root).
# See docs/configuration.md for details on every variable.
# -------------------------------------------------

# Project root directory (logs/ is created here)
PROJECT_ROOT=./

# Data Directories
DATA_DIR=./data
RAW_DIR=./data/raw
EXPERIMENTAL_RAW_PATH=./data/raw/experimental_raw.csv
PROCESSED_DIR=./data/processed
OUTPUT_DIR=./data/output

# Grid Size (microns) - side length of the square substrate
GRID_SIZE_MICRONS=100

# Number of Circles (graphene nucleation sites / flakes)
NUM_CIRCLES=48
RADIUS_MICRONS=0.0914e-3
INITIAL_RADIUS_MICRONS=0.1

# Random Seed (used by the `surface` task)
RANDOM_SEED=10

# Mesh Points (N x N grid used to measure coverage)
MESH_POINTS=1000

# Use Standard Deviation for fitting (True/False)
USE_STD=True

# Generate and save figures (True/False)
SHOW_PLOTS=True

# Number of simulations to run (`n_simulations` task)
SIMULATIONS_TO_RUN=1000

# Max Workers (capped at the number of CPU cores)
MAX_WORKERS=8

# Final Results - directory containing growth_results_simulations_<model>.csv
PERCOLATIONS_CSV_DIR=./data/output/csvs/
